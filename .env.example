# Copie para .env.local e preencha. Chaves salvas no modal "Configurar APIs"
# (localStorage) têm prioridade sobre estas.

# Seats.aero Partner API (disponibilidade de assentos em milhas)
SEATS_AERO_API_KEY=

# SerpApi - Google Flights
SERPAPI_KEY=

# Amadeus Self-Service (Flight Offers Search)
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
# test | production
AMADEUS_ENV=test

# Duffel (opcional)
DUFFEL_ACCESS_TOKEN=
